    "build:data": "tsx scripts/build-data.ts",
    "build:vo": "tsx scripts/build-voiceover.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/google-fonts": "4.0.499",
    "@remotion/renderer": "^4.0.499",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
