{
  "name": "sharpa-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion-kompositioner för Sharpas TikTok-videor. Medvetet isolerat från Next.js-appen — egna node_modules så att Vercel-bygget inte drar in Remotions renderare.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
